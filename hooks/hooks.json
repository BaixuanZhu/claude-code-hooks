{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^(Bash|PowerShell|Edit|Write|Read|Glob|Grep|Agent|Workflow|WebFetch|WebSearch|NotebookEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"${CLAUDE_PLUGIN_ROOT}/hooks/permission_request.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/permission_request.py\"",
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "^ExitPlanMode$",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"${CLAUDE_PLUGIN_ROOT}/hooks/exit_plan_mode_notify.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/exit_plan_mode_notify.py\"",
            "async": true,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"${CLAUDE_PLUGIN_ROOT}/hooks/ask_user_question.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ask_user_question.py\"",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_notify.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_notify.py\"",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_notify.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_notify.py\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"${CLAUDE_PLUGIN_ROOT}/hooks/notification_notify.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/notification_notify.py\"",
            "async": true
          }
        ]
      }
    ]
  }
}
